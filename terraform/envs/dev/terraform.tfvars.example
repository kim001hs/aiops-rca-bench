aws_region          = "ap-northeast-2"
project_name        = "msa-demo"
environment         = "dev"
cluster_name        = "msa-demo-dev-eks"
vpc_cidr            = "10.0.0.0/16"
availability_zones  = ["ap-northeast-2a", "ap-northeast-2c"]
public_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.20.0/24"]

cluster_version     = "1.36"

# 워커 노드 아키텍처 설정 (x86_64 t3.large)
node_instance_types = ["t3.large"]
node_capacity_type  = "ON_DEMAND" # 추가 비용 절감이 필요하면 "SPOT"으로 변경 가능
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 3

# EKS 클러스터 관리자 권한을 부여할 IAM 사용자/역할 목록 (로컬 kubectl 직접 접근용)
admin_principal_arns = [
  "arn:aws:iam::818719120165:user/kim001hs"
]

