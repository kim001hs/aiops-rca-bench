# 로컬 일괄 채점 및 진단용 Gemini API 키 (기본)
GEMINI_API_KEY=your_gemini_api_key_here

# (참고) 할당량 초과 시 수동 교체용 유료 키
# GEMINI_API_KEY_PAID=your_paid_gemini_api_key_here

# AWS 알람 원본 저장 버킷 (terraform/bootstrap의 alert_results_bucket 출력)
ALERT_RESULTS_BUCKET=your_alert_results_bucket_here

# 다른 채점 모델을 사용할 때만 설정
# OPENAI_API_KEY=your_openai_api_key_here

# (선택) 로컬 채점관 모델 (기본값: gemini/gemini-3.1-flash-lite)
# MODEL=gemini/gemini-3.1-flash-lite
# MODEL=openai/gpt-4o-mini
# MODEL=openai/gpt-4o
# MODEL=anthropic/claude-3-5-sonnet-20241022
# MODEL=google/gemini-2.0-flash
